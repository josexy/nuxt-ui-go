{
  "name": "nuxt-ui-go-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:site": "node scripts/prepare.mjs",
    "dev": "pnpm prepare:site && nuxt dev --host 127.0.0.1",
    "generate": "pnpm prepare:site && nuxt generate",
    "typecheck": "nuxt typecheck",
    "preview": "node scripts/serve.mjs",
    "test:snippets": "node scripts/check-snippets.mjs",
    "check": "pnpm format:check && pnpm prepare:site && pnpm typecheck && pnpm test:snippets"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.86",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "4.6.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.1"
  }
}
